# ML models — keep small efficient models, ignore large tree ensembles
# Random Forest and Extra Trees models are 40-70MB each (too large for git)
# They are regenerated by: py scripts/retrain_models.py
models/api_football/*_rf.joblib
models/api_football/*_et.joblib
catboost_info/

# Data files (optional, depending on your strategy)
# data/

# Large data files
data/historical/raw/appearances.csv
all_training_data.csv
# real_football_data.csv stays tracked on purpose: the backend services read it
# and they deploy from this repository.

